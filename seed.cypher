// Patch the Conference — networking agent seed graph
// People, talks and topics. Claudio is the demo user ("You").
// Load with: python3 load.py   (or paste into the FalkorDB Browser at localhost:3000)

CREATE (you:Person {name:'Claudio (You)', role:'Founder, One Dollar Computer', org:'One Dollar Computer'})
CREATE (t_agents:Topic {name:'AI Agents'})
CREATE (t_hw:Topic {name:'Hardware & Robotics'})
CREATE (t_graph:Topic {name:'Knowledge Graphs'})
CREATE (t_edu:Topic {name:'Education'})
CREATE (t_fund:Topic {name:'Fundraising'})
CREATE (t_data:Topic {name:'Web Data'})
CREATE (t_oss:Topic {name:'Open Source'})

CREATE (you)-[:INTERESTED_IN]->(t_agents)
CREATE (you)-[:INTERESTED_IN]->(t_hw)
CREATE (you)-[:INTERESTED_IN]->(t_edu)
CREATE (you)-[:INTERESTED_IN]->(t_oss)

